# shalltear_add_module(name SOURCES files [EDITOR] [OUTPUT_DIRECTORY dir])

# project's CMakeLists.txt should never name a package
function(_shalltear_enabled_package_targets OUT_TARGETS OUT_ANCHORS)
	set(targets "")
	set(anchors "")
	foreach(packageId ${SHALLTEAR_ENABLED_PACKAGES})
		list(FIND SHALLTEAR_PACKAGE_IDS "${packageId}" packageIndex)
		if(packageIndex EQUAL -1)
			message(FATAL_ERROR
				"this build enables '${packageId}', which this engine build does not carry.\n"
				"  It has: ${SHALLTEAR_PACKAGE_IDS}")
		endif()
		list(GET SHALLTEAR_PACKAGE_TARGETS ${packageIndex} packageTarget)
		list(GET SHALLTEAR_PACKAGE_ANCHORS ${packageIndex} packageAnchor)
		list(APPEND targets "${packageTarget}")
		list(APPEND anchors "${packageAnchor}")
	endforeach()
	set(${OUT_TARGETS} "${targets}" PARENT_SCOPE)
	set(${OUT_ANCHORS} "${anchors}" PARENT_SCOPE)
endfunction()

function(_shalltear_write_package_umbrellas TARGET_NAME LINKED_TARGETS)
	set(umbrellaIncludes "")
	foreach(linkedTarget ${LINKED_TARGETS})
		get_target_property(umbrella ${linkedTarget} SHALLTEAR_UMBRELLA)
		if(umbrella)
			string(APPEND umbrellaIncludes "#include \"${umbrella}\"\n")
		endif()
	endforeach()

	set(generatedDir "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated")
	# rewrites only a changed file
	file(CONFIGURE OUTPUT "${generatedDir}/ShalltearPackages.h" CONTENT
"#pragma once

// GENERATED by shalltear_add_module(). Do not edit manually

// IWYU pragma: begin_exports
@umbrellaIncludes@// IWYU pragma: end_exports
" @ONLY NEWLINE_STYLE LF)
	target_include_directories(${TARGET_NAME} PRIVATE "${generatedDir}")
endfunction()

# package link this build didn't make should be refused
function(_shalltear_refuse_unlisted_packages MODULE_NAME ALLOWED REASON)
	cmake_language(EVAL CODE
		"cmake_language(DEFER CALL _shalltear_check_package_links [==[${MODULE_NAME}]==] [==[${ALLOWED}]==] [==[${SHALLTEAR_PACKAGE_TARGETS}]==] [==[${SHALLTEAR_PACKAGE_IDS}]==] ${REASON})")
endfunction()

function(_shalltear_check_package_links MODULE_NAME ALLOWED PACKAGE_TARGETS PACKAGE_IDS REASON)
	get_target_property(linked ${MODULE_NAME} LINK_LIBRARIES)
	if(NOT linked)
		return()
	endif()
	foreach(item IN LISTS linked)
		if(NOT item IN_LIST PACKAGE_TARGETS OR item IN_LIST ALLOWED)
			continue()
		endif()
		list(FIND PACKAGE_TARGETS "${item}" packageIndex)
		list(GET PACKAGE_IDS ${packageIndex} packageId)
		if(REASON STREQUAL "STATIC")
			message(FATAL_ERROR
				"${MODULE_NAME} links ${item}, but this Shalltear SDK is STATIC!\n"
				"  Fix: point Shalltear_ROOT at the shared SDK.")
		endif()
		message(FATAL_ERROR
			"${MODULE_NAME} links ${item}, but ${packageId} is not enabled in this project.\n"
			"  Packages turned on in the Package Manager are linked automatically. Turn this one on there, or remove ${item} from target_link_libraries in CMakeLists.txt.")
	endforeach()
endfunction()

function(shalltear_add_module MODULE_NAME)
	cmake_parse_arguments(SLT_MODULE "EDITOR" "OUTPUT_DIRECTORY" "SOURCES" ${ARGN})

	if(NOT SLT_MODULE_SOURCES)
		message(FATAL_ERROR "shalltear_add_module(${MODULE_NAME}): SOURCES is required and must not be empty.")
	endif()

	if(SHALLTEAR_PLAYER_TARGET)
		_shalltear_add_player_impl(${MODULE_NAME} ${ARGN})
		return()
	endif()

	shalltear_enforce_toolchain(${MODULE_NAME})
	# module built against another commit's headers should be refused
	shalltear_enforce_engine_identity(${MODULE_NAME})

	add_library(${MODULE_NAME} SHARED ${SLT_MODULE_SOURCES})
	target_link_libraries(${MODULE_NAME} PRIVATE Shalltear::Core)
	set_target_properties(${MODULE_NAME} PROPERTIES
		CXX_STANDARD 20
		CXX_STANDARD_REQUIRED ON
		PREFIX ""
		IMPORT_PREFIX "")

	if(SHALLTEAR_LINK_MODE STREQUAL "SHARED")
		target_compile_definitions(${MODULE_NAME} PRIVATE SHALLTEAR_SHARED)
	endif()

	set(linkedPackageTargets "")
	if(NOT SHALLTEAR_LINK_MODE STREQUAL "SHARED")
		_shalltear_refuse_unlisted_packages(${MODULE_NAME} "" STATIC)
	elseif(DEFINED SHALLTEAR_ENABLED_PACKAGES)
		_shalltear_enabled_package_targets(linkedPackageTargets enabledAnchors)
		target_link_libraries(${MODULE_NAME} PRIVATE ${linkedPackageTargets})
		_shalltear_refuse_unlisted_packages(${MODULE_NAME} "${linkedPackageTargets}" DISABLED)
	else()
		message(STATUS "shalltear_add_module(${MODULE_NAME}): SHALLTEAR_ENABLED_PACKAGES is not set, no package is linked. The editor and its generated presets set it.")
	endif()
	_shalltear_write_package_umbrellas(${MODULE_NAME} "${linkedPackageTargets}")

	# user never names the precompiled header
	target_precompile_headers(${MODULE_NAME} PRIVATE
		[[$<$<COMPILE_LANGUAGE:CXX>:"Shalltear.h">]])

	if(SLT_MODULE_EDITOR)
		# module editor extensions are shared link only
		if(NOT SHALLTEAR_LINK_MODE STREQUAL "SHARED")
			message(FATAL_ERROR
				"shalltear_add_module(${MODULE_NAME} EDITOR): module editor extensions require the SHARED Shalltear SDK, "
				"but this one is ${SHALLTEAR_LINK_MODE}.\n"
				"  Fix: point Shalltear_ROOT at the shared SDK (or drop the EDITOR option).")
		endif()
		target_link_libraries(${MODULE_NAME} PRIVATE Shalltear::Editor)
		target_compile_definitions(${MODULE_NAME} PRIVATE SLT_WITH_EDITOR)
	endif()

	# not CMAKE_SOURCE_DIR (breaks under add_subdirectory)
	if(SLT_MODULE_OUTPUT_DIRECTORY)
		set(moduleOutputRoot "${SLT_MODULE_OUTPUT_DIRECTORY}")
	else()
		if(SHALLTEAR_PROJECT_ROOT)
			set(projectRoot "${SHALLTEAR_PROJECT_ROOT}")
		else()
			set(projectRoot "${CMAKE_CURRENT_SOURCE_DIR}")
		endif()
		set(moduleOutputRoot "${projectRoot}/Library/Binaries")
	endif()

	if(CMAKE_CONFIGURATION_TYPES)
		set_target_properties(${MODULE_NAME} PROPERTIES
			RUNTIME_OUTPUT_DIRECTORY "${moduleOutputRoot}/$<CONFIG>")
	else()
		if(CMAKE_BUILD_TYPE)
			set(moduleConfig "${CMAKE_BUILD_TYPE}")
		else()
			set(moduleConfig "Debug")
		endif()
		set_target_properties(${MODULE_NAME} PROPERTIES
			RUNTIME_OUTPUT_DIRECTORY "${moduleOutputRoot}/${moduleConfig}")
	endif()

	add_custom_target(${MODULE_NAME}_ShalltearCompileStamp ALL
		COMMAND ${CMAKE_COMMAND} -E touch "$<TARGET_FILE_DIR:${MODULE_NAME}>/${MODULE_NAME}.compiled"
		VERBATIM)
	add_dependencies(${MODULE_NAME}_ShalltearCompileStamp ${MODULE_NAME})

	_shalltear_write_build_stamp(${MODULE_NAME} FALSE)

	target_compile_options(${MODULE_NAME} PRIVATE -g -gcodeview)
	if(MINGW)
		target_link_options(${MODULE_NAME} PRIVATE -g -Wl,--pdb=)
	else()
		target_link_options(${MODULE_NAME} PRIVATE -g)
	endif()

	target_compile_options(${MODULE_NAME} PRIVATE -fdiagnostics-absolute-paths)

	set_target_properties(${MODULE_NAME} PROPERTIES EXPORT_COMPILE_COMMANDS ON)
endfunction()
