{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name": "Local-Base",
			"hidden": true,
			"description": "Generated by the Shalltear editor, rewritten by Scripts > Regenerate Project Files. Gitignored (absolute paths to this machine). SHALLTEAR_ENABLED_PACKAGES lists the packages the editor loaded (which your code links against).",
			"environment": {
				"PATH": "{{TOOLCHAIN_PATH}}"
			},
			"cacheVariables": { "Shalltear_ROOT": "{{SDK_ROOT}}"{{ENABLED_PACKAGES_ENTRY}} }
		},
		{
			"name": "Debug-Local",
			"displayName": "Debug (this machine's SDK)",
			"inherits": [ "Debug-Base", "Local-Base" ]
		},
		{
			"name": "Release-Local",
			"displayName": "Release (this machine's SDK)",
			"inherits": [ "Release-Base", "Local-Base" ]
		}
	],
	"buildPresets": [
		{ "name": "Debug-Local", "configurePreset": "Debug-Local" },
		{ "name": "Release-Local", "configurePreset": "Release-Local" }
	]
}
