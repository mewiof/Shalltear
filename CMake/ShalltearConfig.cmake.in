get_filename_component(SHALLTEAR_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/@SHALLTEAR_PACKAGE_ROOT_RELATIVE@" ABSOLUTE)

# a module must be produced by a compatible compiler defined here
set(SHALLTEAR_VERSION "@PROJECT_VERSION@")
set(SHALLTEAR_GIT_COMMIT "@SHALLTEAR_GIT_COMMIT@")
set(SHALLTEAR_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(SHALLTEAR_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(SHALLTEAR_COMPILER_TARGET "@SHALLTEAR_COMPILER_TARGET@")
set(SHALLTEAR_LINK_MODE "@SHALLTEAR_LINK_MODE@")

# editor should resolve it from this build
set(SHALLTEAR_COMPILER_PATH "@SHALLTEAR_CONFIG_COMPILER_PATH@")

set(SHALLTEAR_MODULE_ABI_IDENTITY "@SHALLTEAR_MODULE_ABI_IDENTITY@")

set(SHALLTEAR_INCLUDE_DIR "@SHALLTEAR_CONFIG_INCLUDE_DIR@")

# where ShalltearCore.dll/editor executable live
set(SHALLTEAR_RUNTIME_DIR "@SHALLTEAR_CONFIG_RUNTIME_DIR@")

set(SHALLTEAR_PLAYER_SOURCE_DIR "@SHALLTEAR_CONFIG_PLAYER_SOURCE_DIR@")

set(SHALLTEAR_ENGINE_SOURCE_DIR "@SHALLTEAR_CONFIG_ENGINE_SOURCE_DIR@")

include("${CMAKE_CURRENT_LIST_DIR}/ShalltearTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ShalltearPackages.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ShalltearToolchainGuard.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ShalltearPlayer.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ShalltearModule.cmake")

set(Shalltear_FOUND TRUE)
