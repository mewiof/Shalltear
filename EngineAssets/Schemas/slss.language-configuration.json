{

	"comments": {
		"blockComment": ["/*", "*/"]
	},
	"brackets": [
		["{", "}"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "(", "close": ")" },
		{ "open": "/*", "close": " */", "notIn": ["comment"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["(", ")"]
	],
	"folding": {
		"markers": {
			"start": "^\\s*/\\*\\s*#region",
			"end": "^\\s*/\\*\\s*#endregion"
		}
	}
}
