# a glob would join two main()s
function(_shalltear_player_entry_sources OUT_VAR)
	if(NOT SHALLTEAR_PLAYER_SOURCE_DIR)
		message(FATAL_ERROR "the Shalltear package did not record SHALLTEAR_PLAYER_SOURCE_DIR.")
	endif()

	set(entrySource "${SHALLTEAR_PLAYER_ENTRY}")
	if(NOT entrySource)
		set(entrySource "PlayerMain.cpp")
	endif()
	if(NOT EXISTS "${SHALLTEAR_PLAYER_SOURCE_DIR}/${entrySource}")
		message(FATAL_ERROR
			"SHALLTEAR_PLAYER_ENTRY requires '${entrySource}', which this SDK does not have.\n"
			"  Looked in: ${SHALLTEAR_PLAYER_SOURCE_DIR}")
	endif()

	set(${OUT_VAR}
		"${SHALLTEAR_PLAYER_SOURCE_DIR}/${entrySource}"
		"${SHALLTEAR_PLAYER_SOURCE_DIR}/BootManifest.cpp"
		PARENT_SCOPE)
endfunction()

# both modes generate (only the values differ)
function(_shalltear_write_build_stamp TARGET_NAME IS_PLAYER)
	set(SLT_STAMP_NUMBER "0")
	set(SLT_STAMP_TIME_UNIX "0")
	set(SLT_STAMP_TIME_ISO "")
	set(SLT_STAMP_VERSION "")

	if(IS_PLAYER)
		set(SLT_STAMP_IS_PLAYER "true")
		set(SLT_STAMP_TARGET "${SHALLTEAR_PLAYER_TARGET}")
		set(SLT_STAMP_PROFILE "${SHALLTEAR_STAMP_PROFILE}")
		if(DEFINED SHALLTEAR_STAMP_NUMBER)
			set(SLT_STAMP_NUMBER "${SHALLTEAR_STAMP_NUMBER}")
		endif()
		if(DEFINED SHALLTEAR_STAMP_TIME_UNIX)
			set(SLT_STAMP_TIME_UNIX "${SHALLTEAR_STAMP_TIME_UNIX}")
		endif()
		set(SLT_STAMP_TIME_ISO "${SHALLTEAR_STAMP_TIME_ISO}")
		set(SLT_STAMP_VERSION "${SHALLTEAR_STAMP_VERSION}")
	else()
		set(SLT_STAMP_IS_PLAYER "false")
		set(SLT_STAMP_TARGET "")
		set(SLT_STAMP_PROFILE "Editor")
	endif()

	set(stampDir "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated")
	configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildStamp.h.in"
		"${stampDir}/Game/BuildStamp.h"
		@ONLY NEWLINE_STYLE LF)
	foreach(stampedTarget ${TARGET_NAME} ${ARGN})
		target_include_directories(${stampedTarget} PRIVATE "${stampDir}")
	endforeach()
endfunction()

function(_shalltear_write_linked_packages TARGET_NAME OUT_SOURCE OUT_LINK_TARGETS)
	set(anchorDeclarations "")
	set(anchorCalls "")
	_shalltear_enabled_package_targets(linkTargets packageAnchors)

	foreach(packageAnchor ${packageAnchors})
		string(APPEND anchorDeclarations "SLT_DECLARE_LINKED_PACKAGE(${packageAnchor})\n")
		# registrations are attributable
		string(APPEND anchorCalls "\t\tstatic const char token${packageAnchor} = 0;\n")
		string(APPEND anchorCalls "\t\tSLT_CALL_LINKED_PACKAGE(${packageAnchor}, &token${packageAnchor});\n")
	endforeach()

	set(generatedFile "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated/LinkedPackages.generated.cpp")
	file(GENERATE OUTPUT "${generatedFile}" CONTENT
"// GENERATED by shalltear_add_module()'s player branch. Do not edit manually.

#include \"LinkedPackages.h\"

#include \"Shalltear/Core/Module/ModuleAPI.h\"

${anchorDeclarations}
namespace Shalltear {

	void InitializeLinkedPackages() {
${anchorCalls}	}

} // namespace Shalltear
")

	set(${OUT_SOURCE} "${generatedFile}" PARENT_SCOPE)
	set(${OUT_LINK_TARGETS} "${linkTargets}" PARENT_SCOPE)
endfunction()

function(_shalltear_add_player_impl MODULE_NAME)
	cmake_parse_arguments(SLT_PLAYER "EDITOR" "OUTPUT_DIRECTORY" "SOURCES" ${ARGN})

	shalltear_enforce_toolchain(${MODULE_NAME})
	shalltear_enforce_engine_identity(${MODULE_NAME})

	if(NOT SHALLTEAR_LINK_MODE STREQUAL "STATIC")
		message(FATAL_ERROR
			"a Shalltear player links the game statically, but this SDK is ${SHALLTEAR_LINK_MODE}.\n"
			"  Fix: point Shalltear_ROOT at the STATIC package, "
			"and a dev checkout produces one with `python Scripts/build_sdk.py`.")
	endif()

	add_library(${MODULE_NAME} STATIC ${SLT_PLAYER_SOURCES})
	target_link_libraries(${MODULE_NAME} PRIVATE Shalltear::Core)
	set_target_properties(${MODULE_NAME} PROPERTIES
		CXX_STANDARD 20
		CXX_STANDARD_REQUIRED ON
		# own directory to avoid colisions
		ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/GameLib")
	set(playerPrefixMaps
		-fmacro-prefix-map=${CMAKE_SOURCE_DIR}/=
		-fmacro-prefix-map=${CMAKE_BINARY_DIR}/=
		-fmacro-prefix-map=${SHALLTEAR_PACKAGE_ROOT}/=)
	if(SHALLTEAR_ENGINE_SOURCE_DIR)
		list(APPEND playerPrefixMaps -fmacro-prefix-map=${SHALLTEAR_ENGINE_SOURCE_DIR}/=)
	endif()
	target_compile_options(${MODULE_NAME} PRIVATE -fdiagnostics-absolute-paths ${playerPrefixMaps})

	target_precompile_headers(${MODULE_NAME} PRIVATE
		[[$<$<COMPILE_LANGUAGE:CXX>:"Shalltear.h">]])

	if(SHALLTEAR_PLAYER_DEFINES)
		target_compile_definitions(${MODULE_NAME} PRIVATE ${SHALLTEAR_PLAYER_DEFINES})
	endif()

	# means emit symbols in a Release player
	if(SHALLTEAR_PLAYER_DEBUG_SYMBOLS)
		target_compile_options(${MODULE_NAME} PRIVATE -g -gcodeview)
	endif()

	# the EDITOR flag is ignored
	if(SLT_PLAYER_EDITOR)
		message(STATUS "shalltear_add_module(${MODULE_NAME}): building a player (editor extensions aren't linked, SLT_WITH_EDITOR is undefined).")
	endif()

	_shalltear_player_entry_sources(playerEntrySources)
	set(playerTarget "${MODULE_NAME}Player")

	# before the target exists
	_shalltear_write_linked_packages(${playerTarget} playerPackageSource playerPackageTargets)

	target_link_libraries(${MODULE_NAME} PRIVATE ${playerPackageTargets})
	if(DEFINED SHALLTEAR_ENABLED_PACKAGES)
		_shalltear_refuse_unlisted_packages(${MODULE_NAME} "${playerPackageTargets}" DISABLED)
	endif()
	_shalltear_write_package_umbrellas(${MODULE_NAME} "${playerPackageTargets}")

	add_executable(${playerTarget} ${playerEntrySources} "${playerPackageSource}")

	_shalltear_write_build_stamp(${MODULE_NAME} TRUE ${playerTarget})

	target_include_directories(${playerTarget} PRIVATE "${SHALLTEAR_PLAYER_SOURCE_DIR}")

	# profile's name -> target's convention -> module name
	set(playerOutputName "${MODULE_NAME}")
	if(SHALLTEAR_PLAYER_OUTPUT_NAME)
		set(playerOutputName "${SHALLTEAR_PLAYER_OUTPUT_NAME}")
	endif()
	set_target_properties(${playerTarget} PROPERTIES
		OUTPUT_NAME "${playerOutputName}"
		CXX_STANDARD 20
		CXX_STANDARD_REQUIRED ON)

	# game is a windowed app, server a console one
	if(NOT DEFINED SHALLTEAR_PLAYER_WINDOWED)
		set(SHALLTEAR_PLAYER_WINDOWED ON)
	endif()
	if(SHALLTEAR_PLAYER_WINDOWED)
		set_target_properties(${playerTarget} PROPERTIES WIN32_EXECUTABLE ON)
		if(NOT MINGW)
			target_link_options(${playerTarget} PRIVATE "-Wl,/ENTRY:mainCRTStartup")
		endif()
	endif()
	target_link_libraries(${playerTarget} PRIVATE ${MODULE_NAME} ${playerPackageTargets} Shalltear::Core)
	target_compile_options(${playerTarget} PRIVATE ${playerPrefixMaps})
	if(SHALLTEAR_PLAYER_DEFINES)
		target_compile_definitions(${playerTarget} PRIVATE ${SHALLTEAR_PLAYER_DEFINES})
	endif()
	if(SHALLTEAR_PLAYER_DEBUG_SYMBOLS)
		target_compile_options(${playerTarget} PRIVATE -g -gcodeview)
		# no copy step because the PDB shoved beside the exe
		if(MINGW)
			target_link_options(${playerTarget} PRIVATE -g -Wl,--pdb= "-Wl,--Xlink=-pdbaltpath:${playerOutputName}.pdb")
		else()
			target_link_options(${playerTarget} PRIVATE -g)
		endif()
	elseif(MINGW)
		target_link_options(${playerTarget} PRIVATE -Wl,-s)
	endif()

	# whole archive around the game lib only

	# game archive is whole so reflection initializers survive linking
	if(MINGW)
		target_link_options(${playerTarget} PRIVATE
			"-Wl,--whole-archive" "$<TARGET_FILE:${MODULE_NAME}>" "-Wl,--no-whole-archive")
	else()
		target_link_options(${playerTarget} PRIVATE "-Wl,/WHOLEARCHIVE:$<TARGET_FILE:${MODULE_NAME}>")
	endif()

	if(SHALLTEAR_PLAYER_OUTPUT_DIRECTORY)
		set(playerOutput "${SHALLTEAR_PLAYER_OUTPUT_DIRECTORY}")
	else()
		set(playerOutput "${CMAKE_CURRENT_BINARY_DIR}/Player")
	endif()
	if(CMAKE_CONFIGURATION_TYPES)
		foreach(config ${CMAKE_CONFIGURATION_TYPES})
			string(TOUPPER ${config} configUpper)
			set_target_properties(${playerTarget} PROPERTIES
				RUNTIME_OUTPUT_DIRECTORY_${configUpper} "${playerOutput}")
		endforeach()
	endif()
	set_target_properties(${playerTarget} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${playerOutput}")

	set_target_properties(${MODULE_NAME} PROPERTIES EXPORT_COMPILE_COMMANDS ON)
	set_target_properties(${playerTarget} PROPERTIES EXPORT_COMPILE_COMMANDS ON)
endfunction()
