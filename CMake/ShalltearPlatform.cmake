if(WIN32)
	set(SHALLTEAR_PLATFORM_FAMILIES Windows)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
	set(SHALLTEAR_PLATFORM_FAMILIES Posix Linux)
else()
	message(FATAL_ERROR "Shalltear: no platform sources for ${CMAKE_SYSTEM_NAME}.")
endif()

# sources under Private/Platform/<family>/ built only for that family
function(shalltear_select_platform_sources LIST_VAR)
	set(kept "")
	foreach(source ${${LIST_VAR}})
		if(source MATCHES "/Private/Platform/([^/]+)/")
			if(CMAKE_MATCH_1 IN_LIST SHALLTEAR_PLATFORM_FAMILIES)
				list(APPEND kept "${source}")
			endif()
		else()
			list(APPEND kept "${source}")
		endif()
	endforeach()
	set(${LIST_VAR} "${kept}" PARENT_SCOPE)
endfunction()
